# Образец переменных окружения. Реальные значения — только в .env на сервере.

# Деплой (docker compose): домен для HTTPS и пароль базы
DOMAIN=
POSTGRES_PASSWORD=
# Для локальной разработки без Docker; в Docker адрес базы собирает docker-compose.yml
DATABASE_URL=
# Секрет для HMAC токенов сессии, не короче 32 символов: openssl rand -hex 32
SESSION_SECRET=

# Пароль 4 тестовых аккаунтов для npm run db:seed. Пусто — сгенерируется и напечатается в консоль.
# В репозиторий, журнал и PR не попадает (правило 10 AGENTS.md).
SEED_PASSWORD=
# Кнопки «вход без пароля» для жюри на странице входа: on — включены
DEMO_LOGIN=

# Web push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# E-mail
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Ключ шифрования адресов почты (32 байта, base64) и ключ HMAC для кодов подтверждения
EMAIL_ENCRYPTION_KEY=
EMAIL_CODE_HMAC_KEY=
# При DEMO_LOGIN=on — адреса тестовых ящиков команды через запятую
EMAIL_TEST_RECIPIENTS=

# ИИ-помощник: GigaChat — основной (решение 11.11), YandexGPT — запасной
# GIGACHAT_AUTH_KEY — ключ авторизации (Base64 от Client ID:Client Secret) из личного кабинета GigaChat API
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
# Сертификаты НУЦ Минцифры (корневой + выпускающий, PEM) — путь внутри контейнера; без них TLS к Сберу не проходит.
# Используются только клиентом GigaChat. Как получить — deploy/certs/README.md
GIGACHAT_CA_BUNDLE=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Необязательно: каталог вложений портфолио вне public (по умолчанию storage/portfolio)
PORTFOLIO_STORAGE_DIR=
