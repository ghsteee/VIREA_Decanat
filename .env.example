# Образец переменных окружения. Реальные значения — только в .env на сервере.
DATABASE_URL=
SESSION_SECRET=

# Web push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# E-mail
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ИИ-помощник (один из двух)
GIGACHAT_AUTH_KEY=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
